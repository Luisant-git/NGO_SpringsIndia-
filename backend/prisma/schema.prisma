
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImpactYear {
  id           Int           @id @default(autoincrement())
  year         String        @unique
  fromMonth    Int
  fromYear     Int
  toMonth      Int
  toYear       Int
  description  String        @db.Text
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  impactMonths ImpactMonth[]
}

model ImpactMonth {
  id                 Int        @id @default(autoincrement())
  title              String
  monthNumber        Int
  images             String[]   @default([])
  description        String     @db.Text
  impactTitle        String?
  impactDescription  String?     @db.Text
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  impactYearId       Int
  impactYear         ImpactYear @relation(fields: [impactYearId], references: [id], onDelete: Cascade)
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  excerpt     String
  author      String   @default("Springs India Foundation")
  category    String
  image       String
  readTime    String   @default("5 min read")
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   // "annual" or "financial"
  year        String
  filePath    String
  fileName    String
  fileSize    Int
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
